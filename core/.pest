program =  { SOI ~ body ~ EOI }
body    = _{ xps? }

// Keywords
var     = @{ "var" }
val     = @{ "val" }
true    = @{ "true" }
false   = @{ "false" }
fn      = _{ "fn" }
ret     = @{ "ret" }
do      = _{ "do" }
not     = @{ "not" }
for     = @{ "for" }
while   = _{ "while" }
loop    = _{ "loop" }
br      = @{ "br" }
cont    = @{ "cont" }
if      = _{ "if" }
elsif   = _{ "elsif" }
else    = _{ "else" }
match   = @{ "match" }
nil     = @{ "nil" }
keyword =  {
  
  | var
  | val
  | true
  | false
  | fn
  | ret
  | do
  | not
  | for
  | while
  | loop
  | br
  | cont
  | if
  | elsif
  | else
  | match
  | nil
}

// Operators
assignment             = @{ "=" }
addition               = @{ "+" }
subtraction            = @{ "-" }
multiplication         = @{ "*" }
division               = @{ "/" }
exponent               = @{ "^" }
modulo                 = @{ "%" }
greater_than           = @{ ">" }
greater_than_or_equals = @{ ">=" }
less_than              = @{ "<" }
less_than_or_equals    = @{ "<=" }
equals                 = @{ "==" }
not_equals             = @{ "!=" }
and                    = @{ "&&" }
or                     = @{ "||" }
op                     = _{
  
  | addition
  | subtraction
  | multiplication
  | division
  | exponent
  | modulo
  | greater_than
  | greater_than_or_equals
  | less_than
  | less_than_or_equals
  | equals
  | not_equals
  | and
  | or
}

// Operation
operation = { operand ~ (op ~ operand)+ }
operand   = { evaluation }

// Expressions
xps         = _{ (nls ~ xp ~ nls)+ }
xp          =  { operation | evaluation }
evaluation  = _{
  
  | assign
  | block
  | dl
  | loop_block
  | while_block
  | if_chain
  | match_xp
  | member
  | call
  | identifier
  | lit
  | "(" ~ xp ~ ")"
}
broken_xp   =  { br ~ xp? }
returned_xp =  { ret ~ xp? }
// Level System is Unused
lv0     =  { lv1 ~ (lv0_ops ~ lv0)? }
lv1     =  { lv2 ~ (lv1_ops ~ lv1)? }
lv2     =  { lv3 ~ (lv2_ops ~ lv2)? }
lv3     =  {
  
  | block
  | loop_block
  | while_block
  | if_chain
  | match_xp
  | member
  | call
  | identifier
  | lit
  | "(" ~ xp ~ ")"
}
lv0_ops = _{ addition | subtraction }
lv1_ops = _{ multiplication | division }
lv2_ops = _{ exponent }

// Assignment
assign = { identifier ~ "=" ~ xp }

// Paths
member         = { member_subject ~ member_object }
member_subject = { member_term }
member_object  = { ("." ~ (member | member_term | tuple_access)) | index_access }
member_term    = { (call | block | identifier) }
index_access   = { "[" ~ xp ~ "]" }
tuple_access   = { ASCII_DIGIT+ }

// Call
call           =  { callee ~ call_generics? ~ ("()" | "("? ~ call_arguments ~ ")"?) }
call_generics  =  { "<" ~ generic_param+ ~ ">" }
generic_param  = @{ identifier }
callee         = @{ identifier }
call_arguments =  { xp ~ ("," ~ xp)? }

// Declaration
dl = { var_dl | fn_dl }

// Identifiers
// TODO: can we allow identifiers to start with numbers if we exclude all number lits?
// identifier = @{ !number_lit ~ ASCII_ALPHANUMERIC+ }
identifier = @{ !(number_lit | keyword) ~ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }

// Blocks
block         =  { "{" ~ nls ~ block_content ~ nls ~ "}" }
block_content = _{ ((broken_xp | returned_xp | cont | xp) ~ nls)* }

fn_dl            =  { fn_decorators? ~ fn_name ~ fn_type? ~ fn ~ fn_generics? ~ fn_args? ~ fn_return? ~ fn_block? }
fn_decorators    =  { fn_decorator+ }
fn_decorator     =  { "@" ~ decorator_name ~ decorator_params? ~ NEWLINE }
decorator_name   = @{ identifier }
decorator_params =  { xp ~ ("," ~ xp)* }
fn_name          =  { identifier }
fn_type          =  { identifier }
fn_block         =  { block }
fn_generics      =  { "<" ~ fn_generic ~ ("," ~ fn_generic)* ~ ">" }
fn_generic       =  { generic_name ~ generic_bounds? }
generic_name     = @{ identifier }
generic_bounds   =  { generic_bound ~ ("+" ~ generic_bound)* }
generic_bound    = @{ identifier }
fn_args          =  { "("? ~ nls ~ fn_arg? ~ nls ~ (nls ~ "," ~ nls ~ fn_arg)* ~ nls ~ ")"? }
fn_arg           =  { arg_name ~ (":"? ~ arg_type)? }
fn_return        =  { "->" ~ fn_return_type }
fn_return_type   = @{ identifier }
arg_name         = @{ identifier }
arg_type         = @{ identifier }

// Variables
var_dl         =  { var_nomination ~ assignment? ~ var_initial }
var_name       = @{ identifier }
var_type       = @{ identifier }
val_or_var     = @{ var | val }
var_initial    =  { xp }
var_nomination = _{ var_name ~ var_type? ~ val_or_var }

// Literals
lit         = {
  
  | nil_lit
  | array_lit
  | tuple_lit
  | boolean_lit
  | character_lit
  | string_lit
  | number_lit
  | hexadecimal_lit
}
nil_lit     = { nil }
string_lit  = { "'" ~ string_text ~ "'" }
string_text = { (!"'" ~ ANY)* }
// TODO: Implement with c'<char>'
character_lit      =  { "^" ~ ANY }
number_lit         = _{ decimal_lit | binary_lit | octal_lit | hexadecimal_lit }
decimal_lit        =  { "-"? ~ (ASCII_DIGIT | "_")+ ~ ("." ~ (ASCII_DIGIT | "_")*)? }
hexadecimal_lit    =  { "#" ~ ('a'..'f' | 'A'..'F' | ASCII_DIGIT | "_")+ }
binary_lit         =  { "b" ~ ('0'..'1' | "_")+ }
octal_lit          =  { "o" ~ ('0'..'7' | "_")+ }
boolean_lit        =  { true | false }
tuple_lit          =  {
    !"()" ~ "(" ~ nls ~ (tuple_term ~ ",")+ ~ (tuple_term ~ ","?)? ~ nls ~ ")"
}
tuple_term         =  { named_tuple_term | unnamed_tuple_term }
named_tuple_term   =  { identifier ~ xp }
unnamed_tuple_term =  { xp }
array_lit          =  { "[" ~ nls ~ xp? ~ (nls ~ "," ~ nls ~ xp)* ~ "]" }

// If
if_chain     = { if_seg ~ nls ~ (elsif_seg ~ nls)* ~ else_seg? }
if_condition = { "("? ~ xp ~ ")"? }
if_seg       = { if ~ if_condition ~ nls ~ block }
elsif_seg    = { elsif ~ if_condition ~ nls ~ block }
else_seg     = { else ~ nls ~ block }

// Pattern
pattern               = {
    array_pattern
  | destructuring_pattern
  | tuple_pattern
  | var_pattern
}
wildcard              = { "_" }
rest                  = { ".." }
rest_term             = { rest ~ identifier? }
pattern_term          = { identifier | wildcard | rest_term }
var_pattern           = { pattern_term }
tuple_pattern         = { (pattern_term) ~ ("," ~ pattern_term)+ }
array_pattern         = { "[" ~ (pattern_term | rest_term) ~ ("," ~ (pattern_term | rest_term)) ~ "]" }
destructuring_pattern = { "{" ~ (pattern_term | rest_term) ~ ("," ~ (pattern_term | rest_term))+ ~ "}" }

// Match
match_xp    = { match ~ match_term ~ match_block }
match_term  = { xp ~ ("," ~ xp)* }
match_block = { "{" ~ nls ~ (match_arm ~ "," ~ nls)* ~ (match_arm ~ ","?)? ~ nls ~ "}" }
match_arm   = { pattern ~ do ~ xp }

// Loop
loop_block = { loop ~ nls ~ block }

// While
while_block = { while ~ xp ~ do? ~ nls ~ block }

// Comments
COMMENT             = _{ !hexadecimal_lit ~ (multi_comment | inline_comment | single_comment) ~ nls }
single_comment_body =  { (!NEWLINE ~ ANY)* }
single_comment      =  { !"###" ~ !"##" ~ "#" ~ single_comment_body? }
multi_comment_body  =  { (!"###" ~ ANY)* }
multi_comment       =  { "###" ~ multi_comment_body ~ "###" }
inline_comment_body =  { (!"##" ~ ANY)* }
inline_comment      =  { "##" ~ inline_comment_body? ~ "##" }

WHITESPACE = _{ " " }

nls = _{ (NEWLINE)* }
