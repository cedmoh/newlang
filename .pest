program =  { SOI ~ body ~ EOI }
body    = _{ expressions? }

// Keywords
var     = @{ "var" }
val     = @{ "val" }
true    = @{ "true" }
false   = @{ "false" }
fn      = @{ "fn" }
ret     = @{ "ret" }
do      = @{ "do" }
not     = @{ "not" }
for     = @{ "for" }
while   = @{ "while" }
loop    = @{ "loop" }
br      = @{ "br" }
cont    = @{ "cont" }
if      = @{ "if" }
elsif   = @{ "elsif" }
else    = @{ "else" }
match   = @{ "match" }
cite    = @{ "cite" }
keyword =  {
    var
  | val
  | true
  | false
  | fn
  | ret
  | do
  | not
  | for
  | while
  | loop
  | br
  | cont
  | if
  | elsif
  | else
  | match
  | cite
}

// Operators
assignment     = @{ "=" }
addition       = @{ "+" }
subtraction    = @{ "-" }
multiplication = @{ "*" }
division       = @{ "/" }

// Expression
expressions         = _{ (expression ~ newlines)+ }
expression          =  { evaluation }
broken_expression   =  { br ~ expression }
returned_expression =  { ret ~ expression }

evaluation         = {
    block
  | declarations
  | loop_block
  | if_chain
  | match_expression
  | cited_identifier // TODO: path and chain have overlap and fight for priority, combine into one rule

  | chain
  | path
  | literal
}
monadic_operator   = { subtraction ~ not }
monadic_expression = { monadic_operator ~ expression }
diadic_operator    = { addition | subtraction | multiplication | division }
// every possible expression except another diadic
diadic_first_expression = { monadic_expression | evaluation }
diadic_expression       = { diadic_first_expression ~ (diadic_operator ~ expression)* }

// Declarations
declarations = _{ (declaration ~ newlines)+ }
declaration  = _{ var_declaration | fn_declaration }

// Identifiers
// TODO: can we allow identifiers to start with numbers if we exclude all number literals?
// identifier = @{ !number_literal ~ ASCII_ALPHANUMERIC+ }
identifier       = @{ !(number_literal | keyword) ~ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }
cited_identifier =  { cite ~ identifier }

// Blocks
block         = { "{" ~ newlines ~ block_content ~ newlines ~ "}" }
block_content = { ((broken_expression | returned_expression | cont | expression) ~ newlines)* }

// Functions
// this is evaluated to either a function call or a variable access
chain      = { identifier ~ "("? ~ chain_body ~ ")"? }
chain_body = { (expression ~ ","?)* }

fn_declaration =  { fn_name ~ fn_type? ~ fn ~ fn_args? ~ fn_body? }
fn_name        =  { identifier }
fn_type        =  { identifier }
fn_body        =  { fn_block }
fn_block       =  { "{" ~ newlines ~ (expressions | ret)* ~ newlines ~ "}" }
fn_args        =  { "("? ~ fn_arg? ~ ("," ~ fn_arg)* ~ ")"? }
fn_arg         =  { arg_name ~ (":"? ~ arg_type)? }
arg_name       = @{ identifier }
arg_type       = @{ identifier }

// Variables
var_declaration = _{
    literal_var_declaration
  | assignment_var_declaration
  | block_var_declaration
  | uninitialized_var_declaration
}

var_name   = @{ identifier }
var_type   = @{ identifier }
val_or_var = @{ var | val }

var_nomination                = { var_name ~ var_type? ~ val_or_var }
uninitialized_var_declaration = { var_nomination }
block_var_declaration         = { var_nomination ~ block }
literal_var_declaration       = { var_nomination ~ literal }
assignment_var_declaration    = { var_nomination ~ assignment? ~ expression }

// Paths
path            = { identifier ~ (path_member)* }
path_member     = { path_chain | path_identifier | path_number | path_index }
path_identifier = { "." ~ identifier }
path_chain      = { "." ~ chain }
path_number     = { "." ~ (ASCII_DIGIT)+ }
path_index      = { "[" ~ expression ~ "]" }

// Literals
literal        = { tuple_literal | boolean_literal | character_literal | string_literal | number_literal | hexadecimal_literal }
string_literal = { "'" ~ string_text ~ "'" }
string_text    = { (!"'" ~ ANY)* }
// TODO: Implement with c'<char>'
character_literal   = { "^" ~ ANY }
number_literal      = { decimal_literal | binary_literal | octal_literal | hexadecimal_literal }
decimal_literal     = { "-"? ~ (ASCII_DIGIT | "_")+ ~ ("." ~ (ASCII_DIGIT | "_")*)? }
hexadecimal_literal = { "#" ~ ('a'..'f' | 'A'..'F' | ASCII_DIGIT | "_")+ }
binary_literal      = { "b" ~ ('0'..'1' | "_")+ }
octal_literal       = { "o" ~ ('0'..'7' | "_")+ }
boolean_literal     = { true | false }
tuple_literal       = {
    "(" ~ newlines ~ (tuple_term ~ ",")+ ~ (tuple_term ~ ","?)? ~ newlines ~ ")"
}
tuple_term          = { named_tuple_term | unnamed_tuple_term }
named_tuple_term    = { identifier ~ expression }
unnamed_tuple_term  = { expression }

// If
if_chain    = { if_block ~ newlines ~ (elsif_block ~ newlines)* ~ else_block? }
if_block    = { if ~ "("? ~ expression ~ ")"? ~ newlines ~ block }
elsif_block = { elsif ~ "("? ~ expression ~ ")"? ~ newlines ~ block }
else_block  = { else ~ newlines ~ block }

// Pattern
pattern               =  {
    array_pattern
  | destructuring_pattern
  | tuple_pattern
  | var_pattern
}
wildcard              =  { "_" }
rest                  =  { ".." }
rest_term             = @{ rest ~ identifier? }
pattern_term          =  { identifier | wildcard }
var_pattern           =  { pattern_term }
tuple_pattern         =  { (pattern_term) ~ ("," ~ pattern_term)+ }
array_pattern         =  { "[" ~ (pattern_term | rest_term) ~ ("," ~ (pattern_term | rest_term)) ~ "]" }
destructuring_pattern =  { "{" ~ (pattern_term | rest_term) ~ ("," ~ (pattern_term | rest_term))+ ~ "}" }

// Match
match_expression = { match ~ match_term ~ match_block }
match_term       = { expression ~ ("," ~ expression)* }
match_block      = { "{" ~ newlines ~ (match_arm ~ "," ~ newlines)* ~ (match_arm ~ ","?)? ~ newlines ~ "}" }
match_arm        = { pattern ~ do ~ expression }

// Loop
loop_block = { loop ~ NEWLINE? ~ block }

// Comments
COMMENT             = _{ !hexadecimal_literal ~ (multi_comment | inline_comment | single_comment) ~ newlines }
single_comment_body =  { (!NEWLINE ~ ANY)* }
single_comment      =  { !"###" ~ !"##" ~ "#" ~ single_comment_body? }
multi_comment_body  =  { (!"###" ~ ANY)* }
multi_comment       =  { "###" ~ multi_comment_body ~ "###" }
inline_comment_body =  { (!"##" ~ ANY)* }
inline_comment      =  { "##" ~ inline_comment_body? ~ "##" }

WHITESPACE = _{ " " }

newlines = _{ (NEWLINE)* }
