program =  { SOI ~ body ~ EOI }
body    = _{ expressions? }

expressions = _{ expression+ }
expression  = _{ declarations | literal | unresolved_chain }

declarations = _{ (declaration ~ newlines)+ }
declaration  = _{ var_declaration }

// Identifiers
identifier = @{ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }

// this could represent either:
// - a function call
// - or a variable declaration
// depending on the type of the first identifier
unresolved_chain = { identifier ~ (identifier | expression)* }

// Keywords
mut = @{ "mut" }

// Operators
assignment = @{ "=" }

// Variables
var_declaration = _{ assignment_var_declaration | literal_var_declaration | uninitialized_var_declaration }

var_name = @{ identifier }
var_type = @{ identifier }

literal_var_declaration       = { mut? ~ var_name ~ var_type? ~ literal }
uninitialized_var_declaration = { mut ~ var_name ~ var_type? }
assignment_var_declaration    = { mut? ~ var_name ~ var_type? ~ assignment ~ expression }

// Literals
literal        = { string_literal }
string_literal = { "'" ~ string_text ~ "'" }
string_text    = { (!"'" ~ ANY)* }

// Comments
COMMENT             = ${ (multi_comment | inline_comment | single_comment) ~ newlines }
single_comment_body =  { (!NEWLINE ~ ANY)* }
single_comment      =  { !"###" ~ !"##" ~ "#" ~ single_comment_body? }
multi_comment_body  =  { (!"###" ~ ANY)* }
multi_comment       =  { "###" ~ multi_comment_body ~ "###" }
inline_comment_body =  { (!"##" ~ ANY)* }
inline_comment      =  { "##" ~ inline_comment_body? ~ "##" }

WHITESPACE = _{ " " }

newlines = _{ (NEWLINE)* }
