program =  { SOI ~ body ~ EOI }
body    = _{ expressions? }

// Keywords
var     = @{ "var" }
val     = @{ "val" }
true    = @{ "true" }
false   = @{ "false" }
fn      = @{ "fn" }
ret     = @{ "ret" }
do      = @{ "do" }
not     = @{ "not" }
keyword =  { var | val | true | false | fn | ret | do }

// Operators
assignment     = @{ "=" }
addition       = @{ "+" }
subtraction    = @{ "-" }
multiplication = @{ "*" }
division       = @{ "/" }

// Expression
expressions = _{ (expression ~ newlines)+ }
expression  = _{ monadic_expression | diadic_expression | evaluation }

evaluation         = { block | declarations | chain | literal }
monadic_operator   = { subtraction ~ not }
monadic_expression = { monadic_operator ~ expression }
diadic_operator    = { addition | subtraction | multiplication | division }
// every possible expression except another diadic
diadic_first_expression  = { monadic_expression | evaluation }
diadic_expression  = { diadic_first_expression ~ (diadic_operator ~ expression)* }

// Declarations
declarations = _{ (declaration ~ newlines)+ }
declaration  = _{ var_declaration | fn_declaration }

// Identifiers
// TODO: can we allow identifiers to start with numbers if we exclude all number literals?
// identifier = @{ !number_literal ~ ASCII_ALPHANUMERIC+ }
identifier = @{ !(number_literal | keyword) ~ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }

// Blocks
block = { "{" ~ newlines ~ expressions? ~ newlines ~ "}" }

// Functions
// this is evaluated to either a function call or a variable access
chain = { identifier ~ (expression ~ ","?)* }

fn_declaration =  { fn_name ~ fn_type? ~ fn ~ fn_args? ~ fn_body? }
fn_name        =  { identifier }
fn_type        =  { identifier }
fn_body        =  { fn_block }
fn_block       =  { "{" ~ newlines ~ (expressions | ret)* ~ newlines ~ "}" }
fn_args        =  { "("? ~ fn_arg? ~ ("," ~ fn_arg)* ~ ")"? }
fn_arg         =  { arg_name ~ (":"? ~ arg_type)? }
arg_name       = @{ identifier }
arg_type       = @{ identifier }

// Variables
var_declaration = _{ literal_var_declaration | assignment_var_declaration | block_var_declaration | uninitialized_var_declaration }

var_name   = @{ identifier }
var_type   = @{ identifier }
val_or_var = @{ var | val }

var_nomination                = { var_name ~ var_type? ~ val_or_var }
uninitialized_var_declaration = { var_nomination }
block_var_declaration         = { var_nomination ~ block }
literal_var_declaration       = { var_nomination ~ literal }
assignment_var_declaration    = { var_nomination ~ assignment? ~ expression }

// Literals
literal        = { character_literal | string_literal | number_literal | hexadecimal_literal }
string_literal = { "'" ~ string_text ~ "'" }
string_text    = { (!"'" ~ ANY)* }
// TODO: Implement with c'<char>'
character_literal   = { "^" ~ ANY }
number_literal      = { decimal_literal | binary_literal | octal_literal | hexadecimal_literal }
decimal_literal     = { "-"? ~ (ASCII_DIGIT | "_")+ ~ ("." ~ (ASCII_DIGIT | "_")*)? }
hexadecimal_literal = { "#" ~ ('a'..'f' | 'A'..'F' | ASCII_DIGIT | "_")+ }
binary_literal      = { "b" ~ ('0'..'1' | "_")+ }
octal_literal       = { "o" ~ ('0'..'7' | "_")+ }
boolean_literal     = { true | false }

// Comments
COMMENT             = ${ !hexadecimal_literal ~ (multi_comment | inline_comment | single_comment) ~ newlines }
single_comment_body =  { (!NEWLINE ~ ANY)* }
single_comment      =  { !"###" ~ !"##" ~ "#" ~ single_comment_body? }
multi_comment_body  =  { (!"###" ~ ANY)* }
multi_comment       =  { "###" ~ multi_comment_body ~ "###" }
inline_comment_body =  { (!"##" ~ ANY)* }
inline_comment      =  { "##" ~ inline_comment_body? ~ "##" }

WHITESPACE = _{ " " }

newlines = _{ (NEWLINE)* }
