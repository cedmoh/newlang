program = { SOI ~ body ~ EOI }
body    = { expressions? }

expressions = { expression+ }
expression  = { declaration }

declaration     = { var_declaration }
var_declaration = { literal_var_declaration }

// Variables
var_name                = { ASCII_ALPHA+ }
literal_var_declaration = { var_name ~ literal }

// Literals
literal        = { string_literal }
string_literal = { string_marker ~ string_text ~ string_marker }
string_marker  = { "'" }
string_text    = { (!string_marker ~ ANY)* }

// Comments
COMMENT             = ${ (multi_comment | inline_comment | single_comment) ~ newlines }
single_comment_body =  { (!NEWLINE ~ ANY)* }
single_comment      =  { !"###" ~ !"##" ~ "#" ~ single_comment_body? }
multi_comment_body  =  { (!"###" ~ ANY)* }
multi_comment       =  { "###" ~ multi_comment_body ~ "###" }
inline_comment_body =  { (!"##" ~ ANY)* }
inline_comment      =  { "##" ~ inline_comment_body? ~ "##" }

WHITESPACE = _{ " " }

newlines = _{ (NEWLINE)* }
